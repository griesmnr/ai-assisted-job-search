# Copy this file to .env and fill in real values before running
# `docker compose up`. .env is gitignored — never commit it.
#
#   [ -f .env ] || cp .env.example .env
#
# That check is deliberate: a plain `cp .env.example .env` silently
# overwrites an existing .env, and .env is gitignored, so anything already
# in it (rotated API keys, hand-issued credentials) is unrecoverable once
# overwritten. Only ever copy into place when .env does not already exist.

# --- Postgres ---
# USER/PASSWORD/DB are read directly by docker-compose.yml to configure the
# postgres container itself.
POSTGRES_USER=jobsearch
POSTGRES_PASSWORD=changeme
POSTGRES_DB=jobsearch
# HOST/PORT are NOT read by docker-compose.yml -- inside the dev container it
# hardcodes POSTGRES_HOST=postgres itself (see docker-compose.yml). These are
# for app code or tools you run directly on the Mac host, outside Docker,
# connecting to Postgres's published port.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- RabbitMQ ---
# DEFAULT_USER/DEFAULT_PASS are read directly by docker-compose.yml to
# configure the rabbitmq container itself.
RABBITMQ_DEFAULT_USER=jobsearch
RABBITMQ_DEFAULT_PASS=changeme
# HOST/PORT: same story as POSTGRES_HOST/PORT above -- host-side default,
# not read by docker-compose.yml.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672

# --- Anthropic (resume analysis, match scoring) ---
ANTHROPIC_API_KEY=

# --- USAJOBS source ---
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=
